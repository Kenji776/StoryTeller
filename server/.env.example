# Application version (displayed in the footer)
APP_VERSION=1.0

# OpenAI (ChatGPT) API key (optional, populate if using OpenAI)
OPENAI_API_KEY=Open_AI_API_KEY_HERE
# Legacy name for DEFAULT_LLM_MODEL below. Leave unset unless you have a reason:
# it outranks the recommended default, and its only reader is services/llm/defaults.js.
# OPENAI_MODEL=
# Claude (Anthropic) API key (optional, populate if using Anthropic).
# ANTHROPIC_API_KEY is the canonical name and is checked first; CLAUDE_API_KEY is the
# older spelling and still works. Set one, not both.
CLAUDE_API_KEY=Anthropic_API_KEY_HERE
# ANTHROPIC_API_KEY=

# Encrypts the credential vault at server/data/credentials/. Any key set above is
# imported into it on first run, and from then on keys are managed from the admin panel
# rather than from this file.
#
# LEAVE THIS UNSET AND THE VAULT IS MEMORY-ONLY: the server says so at boot, and every
# key a host adds is gone on restart. It never falls back to storing them in plaintext.
# Generate one and keep it — changing it makes the existing vault unreadable:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Left commented out on purpose. A shipped placeholder value would "encrypt" your vault
# under a string published in this repository, which is worse than no encryption because it
# looks like some. Unset, the server keeps keys in memory, says so at boot, and you lose
# nothing but convenience. Generate one with the command above and uncomment.
#
# STORYTELLER_SECRET_FILE=/run/secrets/storyteller  # or point at a file instead
# STORYTELLER_SECRET=

# API key for a self-hosted image server, if yours requires one. The address itself is
# set in the admin panel, not here.
# LOCAL_IMAGE_API_KEY=
#
# What a brand-new lobby starts on. LEAVE BOTH UNSET to use the model the bake-off
# measured as the best price-to-performance option that actually ran the game — read
# from client/config/model_ratings.json, so re-running a sweep moves the default with
# it. Currently that is openai/gpt-4o-mini. Set either to pin your own choice: an
# explicit value always wins, and nothing here is overridden silently.
# See docs/modules/model-bakeoff.md and docs/audits/2026-07-30-model-bakeoff.md.
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=gpt-4o-mini
# Port for the server
PORT=3013
# Elevenlabs API Key (optional — narration also works through a local TTS server)
ELEVEN_API_KEY=ELEVEN_LABS_API_KEY_HERE
# Selected default ElevenLabs voice ID for narration
ELEVEN_VOICE_ID=DEFAULT_VOICE_ID
# Self-hosted OpenAI-compatible TTS server. Only a seed for the first run: the host
# sets the real address in the game's settings window, and that choice is saved to
# server/data/tts-config.json and wins from then on. Must be a private/LAN address.
LOCAL_TTS_URL=http://127.0.0.1:8199
# Suppresses narration and image generation to conserve API spend, and unlocks the
# canned-response test provider. Left TRUE here for a long time, which meant anyone who
# copied this file to play found two headline features silently switched off and no
# indication why. FALSE is the right default for playing; set TRUE while developing.
DEV_MODE=FALSE

# Admin panel password. Deliberately unset: with no value the panel is disabled, which is
# the safe default for a server somebody may expose before they finish reading this file.
# A shipped default — this line used to say `changeme123` — is a known password on every
# install that did not change it. Choose your own and uncomment.
# ADMIN_PASSWORD=